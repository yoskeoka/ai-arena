  "components": {
    "schemas": {
      "Shared.AIBot": {
        "type": "object",
        "required": ["bot_id", "scope_id", "bot_name", "lifecycle_state"],
        "properties": {
          "bot_id": {
            "type": "string"
          },
          "scope_id": {
            "type": "string"
          },
          "bot_name": {
            "type": "string"
          },
          "lifecycle_state": {
            "type": "string",
            "enum": ["active", "retired"]
          },
          "active_submission_id": {
            "type": "string"
          }
        }
      },
      "Shared.AIBotListResponse": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Shared.AIBot"
            }
          }
        }
      },
      "Shared.AISubmission": {
        "type": "object",
        "required": [
          "ai_submission_id",
          "game_registration_id",
          "game",
          "artifact_ref",
          "display_name",
          "runtime_kind",
          "ai_id",
          "validation_state"
        ],
        "properties": {
          "ai_submission_id": {
            "type": "string"
          },
          "game_registration_id": {
            "type": "string"
          },
          "game": {
            "$ref": "#/components/schemas/Shared.GameMetadata"
          },
          "artifact_ref": {
            "type": "string"
          },
          "artifact_id": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "runtime_kind": {
            "type": "string"
          },
          "ai_id": {
            "type": "string"
          },
          "validation_state": {
            "type": "string",
            "enum": ["ready"]
          },
          "source": {
            "type": "string",
            "enum": ["manual", "preset"]
          },
          "source_id": {
            "type": "string"
          }
        }
      },
      "Shared.AISubmissionListResponse": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
