            "type": "string"
          },
          "game_registration_id": {
            "type": "string"
          },
          "artifact_ref": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          }
        }
      },
      "Shared.AISubmissionRevision": {
        "type": "object",
        "required": [
          "ai_submission_id",
          "bot_id",
          "artifact_id",
          "validation_state",
          "created_at"
        ],
        "properties": {
          "ai_submission_id": {
            "type": "string"
          },
          "bot_id": {
            "type": "string"
          },
          "artifact_id": {
            "type": "string"
          },
          "validation_state": {
            "type": "string",
            "enum": ["ready"]
          },
          "created_at": {
            "type": "string"
          }
        }
      },
      "Shared.ArtifactAccessMetadata": {
        "type": "object",
        "required": ["locator"],
        "properties": {
          "locator": {
            "type": "string"
          },
          "download_url": {
            "type": "string"
